# Backend that owns deterministic CLMM data/calculations.
CLMM_DATA_API_BASE=http://localhost:3001
CLMM_INSIGHTS_API_KEY=

# Pipeline metadata.
INTELLIGENCE_CODE_VERSION=development
INTELLIGENCE_PIPELINE_RUN_ID=

# Required by run:core-evidence-pipeline. Derive the 64-character lowercase
# provenance digest from the true deployed Git commit without a trailing newline:
# printf '%s' "$(git rev-parse HEAD)" | sha256sum | cut -d ' ' -f1
INTELLIGENCE_GIT_COMMIT=
# One of: production, staging, development, test
INTELLIGENCE_ENVIRONMENT=development

# Comma-separated list of position IDs for MVP feature derivation.
INTELLIGENCE_POSITION_IDS=

# Optional API keys for collectors.
COINGECKO_API_KEY=
PERPLEXITY_API_KEY=

# News evidence collector configuration (comma-separated source names)
NEWS_SOURCE_ALLOWLIST=
CRYPTO_NEWS_API_URL=
CRYPTO_NEWS_API_KEY=
REGULATORY_MONITOR_API_URL=
REGULATORY_MONITOR_API_KEY=
PERPLEXITY_API_KEY=

# Context events: Solana Statuspage incidents are live and unauthenticated.
# scheduled_event is deferred; set the macro values only for a verified compatible provider.
SOLANA_STATUS_API_URL=https://status.solana.com
SOLANA_STATUS_API_KEY=
MACRO_CALENDAR_API_URL=
MACRO_CALENDAR_API_KEY=

# Support Resistance API configuration (technical-analysis-api provider)
SUPPORT_RESISTANCE_API_URL=
SUPPORT_RESISTANCE_API_KEY=


# On-chain flow: Birdeye (whale_swap, dex_net_flow) + Helius (whale_transfer, position wallet only).
# Helius uses a legacy endpoint; comprehensive realtime flow, stablecoin flows, and CEX identity are not available.
# stablecoin_flow and cex_flow_proxy are deferred.
HELIUS_FLOW_API_URL=https://api.helius.xyz
HELIUS_API_KEY=
BIRDEYE_FLOW_API_URL=https://public-api.birdeye.so
BIRDEYE_API_KEY=
ON_CHAIN_WHALE_TRANSFER_MIN_USDC=1000000
ON_CHAIN_WHALE_SWAP_MIN_USDC=1000000
ON_CHAIN_DEX_NET_FLOW_MIN_USDC=5000000
ON_CHAIN_FLOW_LOOKBACK_MS=900000
# Uses WHIRLPOOL_ADDRESS and WALLET_PUBLIC_KEY declared in 'Pair and pool config' below

# Pyth Hermes and Jupiter API configurations
PYTH_HERMES_BASE_URL=https://hermes.pyth.network
PYTH_API_KEY=
PYTH_SOL_USD_FEED_ID=0xef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# Orca API configuration
ORCA_API_BASE=https://api.orca.so/v2/solana

# Solana RPC API configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_API_KEY=

# Solana token mints.
SOL_MINT=So11111111111111111111111111111111111111112
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Pair and pool config.
PAIR=SOL/USDC
WHIRLPOOL_ADDRESS=Czfq3xZZDmsdGdUyrNLtRhGc47cXcZtLG4crryfu44zE
RAYDIUM_POOL_ID=
WALLET_PUBLIC_KEY=

# Cron registration defaults, consumed by `pnpm cron:sync -- --apply` (see
# scheduling.md). The Hermes gateway that actually runs the scheduled jobs
# does not read this repo's .env — it has its own separate config.
# DELIVERY_CHANNEL/DELIVERY_TO are used (mapped into each job's --deliver
# flag). MODEL/THINKING/AGENT/EXACT are read but currently have no effect:
# Hermes has no per-job model/thinking/agent/exact override.
# Must be an absolute path on the host running cron:sync. Sync fails closed if
# this file is missing, malformed, or contains duplicate job names. Omitting it
# uses $HOME/.hermes/cron/jobs.json. Do not put ~ in the value because FsTextReader does not expand it.
HERMES_JOBS_FILE_PATH=/root/.hermes/cron/jobs.json
OPENCLAW_MODEL=opus
OPENCLAW_THINKING=high
OPENCLAW_AGENT=
OPENCLAW_DELIVERY_CHANNEL=telegram
OPENCLAW_DELIVERY_TO=
OPENCLAW_EXACT=true

# Safety switch. Scripts refuse execution-mode actions unless false.
RECOMMENDATION_ONLY=true

# --- Regime Engine (evidence bundle endpoint) ---
REGIME_ENGINE_BASE_URL=http://localhost:4000
REGIME_ENGINE_AUTH_TOKEN=

# --- Pack C: Perp & Liquidation Collector Configuration ---
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BINANCE_SOL_PERP_SYMBOL=SOLUSDT
DRIFT_DATA_API_BASE_URL=https://data.velocity.exchange
DRIFT_SOL_PERP_SYMBOL=SOL-PERP
DRIFT_SOL_PERP_MARKET_INDEX=0
DRIFT_PRICE_PRECISION=1000000
DRIFT_BASE_PRECISION=1000000000
DRIFT_QUOTE_PRECISION=1000000
PERP_LIQUIDATION_LOOKBACK_MS=14400000

# --- Database (shared Railway Postgres, intelligence schema) ---
DATABASE_URL=postgres://user:pass@host:5432/db
PG_SSL=true
PG_MAX_CONNECTIONS=10

# --- LLM Provider Configuration (for Research Brief generation) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_MODEL_VERSION=
LLM_TIMEOUT_MS=30000

